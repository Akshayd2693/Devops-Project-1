pipeline {
    agent any

    environment {
        DOCKER_USER = "akshayd2693"
        BACKEND_IMAGE = "akshayd2693/student-task-backend"
        FRONTEND_IMAGE = "akshayd2693/student-task-frontend"
        
        BACKEND_YAML = "student-task-manager/k8s/backend-deployment.yaml"
        FRONTEND_YAML = "student-task-manager/k8s/frontend-deployment.yaml"
        GIT_BRANCH = "main" 
    }

    stages {
        stage("Checkout") {
            steps {
                checkout scm
            }
        }

        // Yeh Parent Stage tabhi chalega jab commit message me [ci skip] NAHI hoga
        stage("Main CI/CD Pipeline") {
            when {
                expression {
                    def commitMsg = sh(script: 'git log -1 --pretty=%B', returnStdout: true).trim()
                    if (commitMsg.contains('[ci skip]')) {
                        echo "🛑 Automated commit detected ([ci skip]). Skipping the entire build process to prevent infinite loop."
                        return false // Pipeline yahi ruk jayegi
                    } else {
                        echo "✅ Manual push detected. Proceeding with the build..."
                        return true // Pipeline aage badhegi
                    }
                }
            }
            
            // Agar upper wali condition true (manual push) hui, tabhi yeh andar ke stages chalenge
            stages {
                stage("Calculate Next Version") {
                    steps {
                        script {
                            env.IMAGE_TAG = sh(
                                script: '''
                                    CURRENT_TAG=$(grep 'student-task-frontend:' ${FRONTEND_YAML} | awk -F':' '{print $3}' | tr -d ' ' | tr -d '\r')
                                    BASE_VERSION=$(echo $CURRENT_TAG | cut -d. -f1,2)
                                    PATCH_VERSION=$(echo $CURRENT_TAG | cut -d. -f3)
                                    NEXT_PATCH=$((PATCH_VERSION + 1))
                                    echo "${BASE_VERSION}.${NEXT_PATCH}"
                                ''',
                                returnStdout: true
                            ).trim()
                            echo "Next Image Tag will be: ${env.IMAGE_TAG}"
                        }
                    }
                }

                stage("Docker Login") {
                    steps {
                        withCredentials([
                            usernamePassword(
                                credentialsId: "Github-credentials", // Ensure this ID is correct for Docker Hub or use your specific Docker credential ID
                                usernameVariable: "DOCKER_USERNAME",
                                passwordVariable: "DOCKER_PASSWORD"
                            )
                        ]) {
                            sh '''
                                echo "$DOCKER_PASSWORD" | docker login \
                                -u "$DOCKER_USERNAME" \
                                --password-stdin
                            '''
                        }
                    }
                }

                stage("Build Backend") {
                    steps {
                        sh '''
                            docker build \
                            -t ${BACKEND_IMAGE}:${IMAGE_TAG} \
                            -t ${BACKEND_IMAGE}:latest \
                            ./student-task-manager/backend
                        '''
                    }
                }

                stage("Build Frontend") {
                    steps {
                        sh '''
                            docker build \
                            -t ${FRONTEND_IMAGE}:${IMAGE_TAG} \
                            -t ${FRONTEND_IMAGE}:latest \
                            ./student-task-manager/frontend
                        '''
                    }
                }

                stage("Push Images") {
                    steps {
                        sh '''
                            docker push ${BACKEND_IMAGE}:${IMAGE_TAG}
                            docker push ${BACKEND_IMAGE}:latest
                            docker push ${FRONTEND_IMAGE}:${IMAGE_TAG}
                            docker push ${FRONTEND_IMAGE}:latest
                        '''
                    }
                }

                stage("Update K8s Manifests & Push to GitHub") {
                    steps {
                        withCredentials([
                            usernamePassword(
                                credentialsId: "Github-credentials", 
                                usernameVariable: "GIT_USERNAME",
                                passwordVariable: "GIT_TOKEN"
                            )
                        ]) {
                            sh '''
                                sed -i "s|${BACKEND_IMAGE}:.*|${BACKEND_IMAGE}:${IMAGE_TAG}|g" ${BACKEND_YAML}
                                sed -i "s|${FRONTEND_IMAGE}:.*|${FRONTEND_IMAGE}:${IMAGE_TAG}|g" ${FRONTEND_YAML}

                                git config user.name "Jenkins CI"
                                git config user.email "jenkins@ci.local"

                                git add ${BACKEND_YAML} ${FRONTEND_YAML}
                                git commit -m "chore(k8s): bump image versions to ${IMAGE_TAG} [ci skip]" || echo "No changes to commit"

                                REPO_URL=$(git config --get remote.origin.url | sed 's|https://||')
                                git push https://${GIT_USERNAME}:${GIT_TOKEN}@${REPO_URL} HEAD:${GIT_BRANCH}
                            '''
                        }
                    }
                }
            }
        }
    }

    post {
        success {
            echo "✅ Pipeline finished successfully!"
        }
        failure {
            echo "❌ Pipeline failed! Please check the logs."
        }
        always {
            script {
                try {
                    sh 'docker logout || true'
                } catch (Exception e) {
                    echo "Could not execute docker logout: ${e.message}"
                }
            }
        }
    }
}
